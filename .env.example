# Copy to .env.local and fill in. Never commit .env.local.

# Required in production: signs the cart cookie (any long random string)
COOKIE_SECRET=change-me-to-a-long-random-string
SITE_URL=https://purposelabsau.com

# Bank transfer details shown on the order page and in the order email
BANK_ACCOUNT_NAME=
BANK_BSB=
BANK_ACCOUNT_NUMBER=

# ---- Email: Titan webmail (titan.email) ----
# Use a Titan mailbox you created (e.g. orders@purposelabsau.com) and its password.
# Titan only sends mail "from" the mailbox you log in with.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@purposelabsau.com
SMTP_PASS=
MAIL_FROM_NAME=Purpose Labs
# Where new-order notifications and contact-form messages go (defaults to SMTP_USER)
STORE_EMAIL=

# Where orders.json / messages.json are stored (default ./data)
DATA_DIR=
